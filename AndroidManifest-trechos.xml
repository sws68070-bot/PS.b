<!--
  Este arquivo NÃO é pra substituir o AndroidManifest.xml inteiro.
  É só pra você COPIAR estas linhas para dentro do arquivo que já existe em:
  android/app/src/main/AndroidManifest.xml

  (o Capacitor já gera esse arquivo quando você roda "npx cap add android")
-->

<!-- 1) Adicione estas duas linhas ANTES da tag <application> -->
<uses-permission android:name="android.permission.CAMERA" />
<uses-feature android:name="android.hardware.camera" android:required="true" />
<uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

<!--
  2) Dentro da tag <application ...>, confirme que já existe (o Capacitor cria por padrão):
     android:hardwareAccelerated="true"

  Exemplo de como a tag <application> deve ficar (resumido):
-->
<application
    android:hardwareAccelerated="true"
    android:allowBackup="true"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:theme="@style/AppTheme">

    <!-- ... resto do conteúdo gerado automaticamente pelo Capacitor ... -->

</application>
